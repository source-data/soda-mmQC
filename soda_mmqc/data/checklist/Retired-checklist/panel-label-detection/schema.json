{
  "format": {
    "type": "json_schema",
    "name": "panel-label-detection",
    "schema": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel as shown in the figure (e.g. A, B, (a), 1)"
              }
            },
            "required": ["panel_label"],
            "additionalProperties": false
          }
        }
      },
      "required": ["outputs"],
      "additionalProperties": false
    },
    "strict": true
  }
}
