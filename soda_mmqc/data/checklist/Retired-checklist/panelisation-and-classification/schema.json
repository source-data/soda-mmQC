{
    "format": {
        "type": "json_schema",
        "name": "panelisation-and-classification",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_a_micrograph": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains a micrograph or microscopic image"
                            },
                            "is_a_nummerical_data_plot": {
                                "type": "string",
                                "enum": ["yes", "no", ""],
                                "description": "Whether the panel contains a plot of nummerical data"
                            },
                            "is_a_scheme": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains a scheme"
                            },
                            "is_mixed": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains multiple types (e.g., both micrograph and plot)"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_a_micrograph",
                            "is_a_nummerical_data_plot",
                            "is_a_scheme",
                            "is_mixed"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}