{
  "format": {
    "type": "json_schema",
    "name": "SD-mapping",
    "schema": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Panel label as shown in the figure (e.g. A, B, C)"
              },
              "source_data_filenames": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Filenames of source data files that correspond to this panel"
              }
            },
            "required": ["panel_label", "source_data_filenames"],
            "additionalProperties": false
          }
        }
      },
      "required": ["outputs"],
      "additionalProperties": false
    },
    "strict": true
  }
}
