{
  "checklist": "plot-gap-labeling",
  "defaults": {
    "matching_metric": "binary_polarity",
    "positive_value": "yes",
    "negative_value": "no",
    "na_values": []
  },
  "list_alignment": {
    "outputs": ["panel_label"],
    "outputs.gaps_defined": ["axis"],
    "outputs.gap_description": ["axis"],
    "outputs.justify_why_gaps_are_missing": ["axis"]
  },
  "fields": {
    "outputs[].panel_label": {
      "matching_metric": "graded_string",
      "string_compare": "exact",
      "match_threshold": 1.0
    },
    "outputs[].is_a_plot": {
      "matching_metric": "binary_polarity"
    },
    "outputs[].gaps_defined[].axis": {
      "matching_metric": "multiclass"
    },
    "outputs[].gaps_defined[].answer": {
      "na_values": ["not needed"],
      "matching_metric": "binary_polarity"
    },
    "outputs[].gap_description[].axis": {
      "matching_metric": "multiclass"
    },
    "outputs[].gap_description[].definition": {
      "matching_metric": "graded_string",
      "na_values": [""],
      "string_compare": "semantic",
      "match_threshold": 0.8
    },
    "outputs[].justify_why_gaps_are_missing[].axis": {
      "matching_metric": "multiclass"
    },
    "outputs[].justify_why_gaps_are_missing[].justification": {
      "matching_metric": "graded_string",
      "na_values": [""],
      "string_compare": "semantic",
      "match_threshold": 0.8
    }
  }
}
