{
    "format": {
        "type": "json_schema",
        "name": "stat-significance-level",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_a_plot": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the figure is a plot"
                            },
                            "significance_level_symbols_on_image": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Significance level symbols on the image"
                            },
                            "significance_level_symbols_defined_in_image": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": ["yes", "no"]
                                },
                                "description": "Whether each significance level symbol is defined directly on the image (e.g., p-value shown next to symbol)"
                            },
                            "significance_level_symbols_defined_in_caption": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": ["yes", "no", "not_needed"]
                                },
                                "description": "Whether each significance level symbol is defined in the caption (use 'not_needed' if defined in image)"
                            },
                            "from_the_caption": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Extracted text explaining the significance level symbols (use 'not_needed' if defined in image)"
                            },
                            "Decision_and_explanation": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Panel-level verdict and brief rationale (e.g. PASS, FAIL, or WARNING) on whether significance levels are adequately defined; use empty array when not applicable"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_a_plot",
                            "significance_level_symbols_on_image",
                            "significance_level_symbols_defined_in_image",
                            "significance_level_symbols_defined_in_caption",
                            "from_the_caption",
                            "Decision_and_explanation"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}