{
    "format": {
        "type": "json_schema",
        "name": "n-larger-two",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_numerical_plot": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains a numerical data plot"
                            },
                            "shows_averaged_data": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether the plot shows averaged/aggregated data from multiple experimental repetitions (e.g., error bars, boxplots, bar charts with averages, violin plots). Set to 'not_applicable' if not a numerical plot."
                            },
                            "n_value": {
                                "type": "string",
                                "pattern": "^(\\d+|not_mentioned|not_applicable)$",
                                "description": "Number of replicates (n). Provide as a string (e.g., '2', '3', '5') if mentioned, 'not_mentioned' if not stated, 'not_applicable' if the plot does not show averaged data or is not a numerical plot"
                            },
                            "n_larger_than_two": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether n > 2 when averaged data is shown (yes if n > 2, no if n ≤ 2, not_applicable if n not mentioned or if plot does not show averaged data)"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_numerical_plot",
                            "shows_averaged_data",
                            "n_value",
                            "n_larger_than_two"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}
