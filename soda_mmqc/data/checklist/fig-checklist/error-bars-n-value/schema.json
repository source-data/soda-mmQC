{
    "format": {
        "type": "json_schema",
        "name": "error-bars-n-value",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_numerical_plot": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains a numerical data plot"
                            },
                            "has_error_bars": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether the plot has error bars (not_applicable if not a numerical plot)"
                            },
                            "n_value": {
                                "type": "string",
                                "description": "Number of replicates (n). Provide as a string (e.g., '2', '3', '5') if mentioned, 'not_mentioned' if not stated, 'not_applicable' if no error bars"
                            },
                            "n_inappropriate_for_error_bars": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether n is inappropriate for error bars (yes if n<=2 with error bars, no if n>2 with error bars or no error bars, not_applicable if n not mentioned or no error bars)"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_numerical_plot",
                            "has_error_bars",
                            "n_value",
                            "n_inappropriate_for_error_bars"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}
