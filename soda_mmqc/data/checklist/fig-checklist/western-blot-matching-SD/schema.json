{
  "format": {
    "type": "json_schema",
    "name": "western-blot-matching-SD",
    "schema": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Panel letter (e.g. A, B, C)"
              },
              "is_western_blot": {
                "type": "string",
                "enum": ["TRUE", "FALSE"],
                "description": "Whether this panel shows western blot or gel-based data"
              },
              "source_data_matches_figure": {
                "type": "string",
                "enum": ["yes", "no", "not_applicable", "cannot_determine"],
                "description": "Whether source data matches what is shown in the figure"
              },
              "discrepancies": {
                "type": "string",
                "description": "Description of mismatches, or empty string"
              }
            },
            "required": ["panel_label", "is_western_blot", "source_data_matches_figure", "discrepancies"],
            "additionalProperties": false
          }
        }
      },
      "required": ["outputs"],
      "additionalProperties": false
    },
    "strict": true
  }
}
