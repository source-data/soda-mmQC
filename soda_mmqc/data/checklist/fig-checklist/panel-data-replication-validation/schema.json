{
  "format": {
    "type": "json_schema",
    "name": "panel-data-replication-validation",
    "schema": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "plot_type": {
                "type": "string",
                "enum": [
                  "line_plot",
                  "bar_chart",
                  "scatter_plot",
                  "box_plot",
                  "heatmap",
                  "micrograph",
                  "schematic",
                  "other",
                  "unknown"
                ],
                "description": "Type of visualization detected in the panel"
              },
              "image_matches_caption": {
                "type": "string",
                "enum": ["yes", "no", "not_applicable"],
                "description": "Whether the panel image content matches what is described in the figure caption"
              },
              "replicable_from_data": {
                "type": "string",
                "enum": ["yes", "partial", "no", "not_applicable"],
                "description": "Whether the plot/figure in the panel can be replicated from the provided tabular data"
              },
              "image_matches_data": {
                "type": "string",
                "enum": ["yes", "partial", "no", "not_applicable"],
                "description": "Whether the panel image is consistent with (i.e., agrees with) the provided tabular data when replication is attempted"
              },
              "discrepancies": {
                "type": "string",
                "description": "Description of any substantive discrepancies among the panel image, caption, and/or tabular data; or empty string if no discrepancies"
              }
            },
            "required": [
              "panel_label",
              "plot_type",
              "image_matches_caption",
              "replicable_from_data",
              "image_matches_data",
              "discrepancies"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["outputs"],
      "additionalProperties": false
    },
    "strict": true
  }
}
