{
    "format": {
        "type": "json_schema",
        "name": "method-is-mentioned",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "method-is-mentioned": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether experimental method can be confidently identified"
                            },
                            "method_source": {
                                "type": "string",
                                "enum": ["caption", "panel", "not_identifiable"],
                                "description": "Where the experimental method information comes from"
                            },
                            "from_the_caption": {
                                "type": "string",
                                "description": "Text from caption describing experimental method"
                            }
                        },
                        "required": [
                            "panel_label",
                            "method-is-mentioned",
                            "method_source",
                            "from_the_caption"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}