{
  "type": "object",
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "description": "Panel-level model output for one figure caption segmentation call",
      "items": {
        "type": "object",
        "required": ["label", "is_micrograph"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Panel label (e.g. 1A, 2B)"
          },
          "is_micrograph": {
            "type": "string",
            "enum": ["yes", "no", ""],
            "description": "Whether the panel shows a micrograph"
          },
          "caption_snippet": {
            "type": "string",
            "description": "Short caption text describing the panel"
          }
        }
      }
    }
  }
}
